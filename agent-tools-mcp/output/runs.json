    {
      "scenario": "holiday-bridge",
      "events": [
        {
          "type": "question",
          "text": "I'm based in Berlin, Germany. I have 5 days of holiday left for 2026 and my full 28 days for 2027. I'd like to be off from Saturday 19 December 2026 to Sunday 10 January 2027. How many leave days does that use from each year, and does it work with my balances?"
        },
        {
          "type": "llm_start",
          "id": "01a12ff4-3a2b-7e93-9a9e-99d83379cb17",
          "turn": 1,
          "node": "model",
          "message_count": 2
        },
        {
          "type": "llm_end",
