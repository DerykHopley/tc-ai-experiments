{
  "name": "rag-langchain",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write 'src/**/*.ts'",
    "chroma": "chroma run --path ./chroma-data --port 8001",
    "reindex": "tsx --env-file-if-exists=.env --no-deprecation src/reindex.ts",
    "1-load": "tsx --env-file-if-exists=.env --no-deprecation src/1-load.ts",
    "2-split": "tsx --env-file-if-exists=.env --no-deprecation src/2-split.ts",
    "3-search": "tsx --env-file-if-exists=.env --no-deprecation src/3-search.ts",
    "4-rag": "tsx --env-file-if-exists=.env --no-deprecation src/4-rag.ts",
    "5-visualize": "tsx --env-file-if-exists=.env --no-deprecation src/5-visualize.ts",
    "6-walkthrough": "tsx --env-file-if-exists=.env --no-deprecation src/6-walkthrough.ts",
    "7-evaluate": "tsx --env-file-if-exists=.env --no-deprecation src/7-evaluate.ts",
    "8-compare": "tsx --env-file-if-exists=.env --no-deprecation src/8-compare.ts",
    "file": "tsx --env-file-if-exists=.env --no-deprecation",
    "9-rerank-report": "tsx --env-file-if-exists=.env --no-deprecation src/9-rerank-report.ts",
    "9-rerank-consistency": "tsx --env-file-if-exists=.env --no-deprecation src/9-rerank-consistency.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@langchain/classic": "^1.0.52",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.17",
    "@langchain/openai": "^1.6.2",
    "@langchain/textsplitters": "^1.0.2",
    "@thi.ng/tsne": "^0.1.75",
    "chromadb": "^3.5.0",
    "d3-dsv": "^3.0.1",
    "langchain": "^1.5.15",
    "zod": "^4.6.5"
  }
}
